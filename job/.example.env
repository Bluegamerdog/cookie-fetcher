# Roblox credentials
ROBLOX_USER=your_roblox_username
ROBLOX_PASS=your_roblox_password

# Browser
RUN_HEADLESS=true

# GCP; required for Secret Manager write
GCP_PROJECT_ID=your-gcp-project-id
# Must match ROBLOX_COOKIE's secret name in scipnet-api's secrets.loader.ts
SECRET_NAME=api-roblox-cookie

# `service` is always running (no scaling needed) — where to report status and,
# if a CAPTCHA comes up, relay screenshots/clicks
COOKIE_SERVICE_URL=http://localhost:8080
