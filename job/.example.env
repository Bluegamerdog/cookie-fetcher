# Roblox credentials
ROBLOX_USER=your_roblox_username
ROBLOX_PASS=your_roblox_password

# Browser
RUN_HEADLESS=true

# GCP; required for Secret Manager write and service scaling
GCP_PROJECT_ID=your-gcp-project-id
COOKIE_SERVICE_NAME=scipnet-cookie-fetcher
COOKIE_SERVICE_REGION=europe-west1
SECRET_NAME=api-roblox-token