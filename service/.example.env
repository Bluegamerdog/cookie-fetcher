# Port the webhook server listens on
PORT=8080

# GCP; required to trigger `job`'s Cloud Run Job execution when the API requests a
# refresh over WS. Must match the region/job used in the `job` deployment.
GCP_PROJECT_ID=your-gcp-project-id
COOKIE_JOB_NAME=your-cloud-run-job-name
COOKIE_JOB_REGION=europe-west1